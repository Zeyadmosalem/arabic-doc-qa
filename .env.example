# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=

# Chat model used to write the final answer from the retrieved chunks
GROQ_MODEL=qwen/qwen3.8-27b

# Jina API key — https://jina.ai/embeddings (free tier, no card)
JINA_API_KEY=

# Multilingual embedding model used for Arabic + English. 1024 dimensions;
# changing this means recreating the Qdrant collection.
EMBEDDING_MODEL=jina-embeddings-v3

# Qdrant endpoint. Either a Qdrant Cloud free-tier cluster URL
# (https://<cluster-id>.<region>.cloud.qdrant.io:6333) or a local Docker
# container (docker run -p 6333:6333 qdrant/qdrant).
QDRANT_URL=http://localhost:6333

# Qdrant API key — required for Qdrant Cloud, leave empty for local Docker
QDRANT_API_KEY=

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Largest document the synchronous ingest path will accept
MAX_PAGES=20
