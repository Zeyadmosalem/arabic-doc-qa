# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=

# Chat model used to write the final answer from the retrieved chunks
GROQ_MODEL=qwen/qwen3.8-27b

# Which embedding API to call: "gemini" or "jina". Both return 1024 dimensions,
# so switching does not require re-indexing — but the vectors are not
# interchangeable, so the collection must be rebuilt when you switch.
EMBEDDING_PROVIDER=gemini

# Google AI Studio key — https://aistudio.google.com/apikey (free, no card)
GEMINI_API_KEY=

# Jina API key — https://jina.ai/embeddings (free tier is small and runs out)
JINA_API_KEY=

# Embedding model for the chosen provider. gemini-embedding-001 for gemini,
# jina-embeddings-v3 for jina.
EMBEDDING_MODEL=gemini-embedding-001

# Qdrant endpoint. Either a Qdrant Cloud free-tier cluster URL
# (https://<cluster-id>.<region>.cloud.qdrant.io:6333) or a local Docker
# container (docker run -p 6333:6333 qdrant/qdrant).
QDRANT_URL=http://localhost:6333

# Qdrant API key — required for Qdrant Cloud, leave empty for local Docker
QDRANT_API_KEY=

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Largest document the synchronous ingest path will accept
MAX_PAGES=20
