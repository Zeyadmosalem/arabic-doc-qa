# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=

# Chat model used to write the final answer from the retrieved chunks
GROQ_MODEL=llama-3.1-8b-instant

# Qdrant endpoint. Either a Qdrant Cloud free-tier cluster URL
# (https://<cluster-id>.<region>.cloud.qdrant.io:6333) or a local Docker
# container (docker run -p 6333:6333 qdrant/qdrant).
QDRANT_URL=http://localhost:6333

# Qdrant API key — required for Qdrant Cloud, leave empty for local Docker
QDRANT_API_KEY=

# Multilingual sentence-transformers model used for Arabic + English embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-base
